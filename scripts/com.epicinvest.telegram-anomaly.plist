<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.epicinvest.telegram-anomaly</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/jsa/work/epic_invest/.venv/bin/python</string>
        <string>/Users/jsa/work/epic_invest/scripts/telegram_anomaly_alarm.py</string>
    </array>

    <!-- launchd uses LOCAL time; 09:30 KST → Hour=9 on a KST host.
         Also fixed the key name: CalendarInterval was wrong and silently
         ignored by launchd; the correct key is StartCalendarInterval. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>EnvironmentVariables</key>
    <dict>
        <key>DOTENV_PATH</key>
        <string>/Users/jsa/work/epic_invest/.env</string>
        <key>PYTHONPATH</key>
        <string>/Users/jsa/work/epic_invest/scripts</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/jsa/work/epic_invest</string>

    <key>StandardOutPath</key>
    <string>/Users/jsa/work/epic_invest/logs/telegram-anomaly.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/jsa/work/epic_invest/logs/telegram-anomaly-err.log</string>

    <key>RunAtLoad</key>
    <false/>

    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
