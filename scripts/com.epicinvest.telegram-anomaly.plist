<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.epicinvest.telegram-anomaly</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/jsa/work/epic_invest/.venv/bin/python</string>
        <string>/Users/jsa/work/epic_invest/scripts/telegram_anomaly_alarm.py</string>
    </array>

    <!-- Host-TZ independent: fire at :30 every hour, let the Python script
         self-gate to KST hour 9. Earlier Hour=9 only worked on a KST host;
         this host runs UTC+8 so the literal-hour approach was off by one. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>EnvironmentVariables</key>
    <dict>
        <key>DOTENV_PATH</key>
        <string>/Users/jsa/work/epic_invest/.env</string>
        <key>PYTHONPATH</key>
        <string>/Users/jsa/work/epic_invest/scripts</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/jsa/work/epic_invest</string>

    <key>StandardOutPath</key>
    <string>/Users/jsa/work/epic_invest/logs/telegram-anomaly.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/jsa/work/epic_invest/logs/telegram-anomaly-err.log</string>

    <key>RunAtLoad</key>
    <false/>

    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
