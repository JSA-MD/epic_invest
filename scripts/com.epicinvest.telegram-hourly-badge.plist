<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.epicinvest.telegram-hourly-badge</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/jsa/work/epic_invest/.venv/bin/python</string>
        <string>/Users/jsa/work/epic_invest/scripts/telegram_hourly_badge.py</string>
    </array>

    <!--
        Fire at :00 every hour, host-TZ independent. The Python script
        self-gates: it sends only when KST hour ∈ [9, 21]; outside that
        window it exits 0 silently. This avoids re-encoding the host
        timezone in the plist hour values.
    -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/jsa/work/epic_invest</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/jsa/work/epic_invest/.venv/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>DOTENV_PATH</key>
        <string>/Users/jsa/work/epic_invest/.env</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/epic-invest-telegram-hourly-badge.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/epic-invest-telegram-hourly-badge.err</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
