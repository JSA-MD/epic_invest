<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.epicinvest.weekly-validation</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/jsa/work/epic_invest/.venv/bin/python</string>
        <string>/Users/jsa/work/epic_invest/scripts/weekly_validation.py</string>
    </array>

    <!-- Every Sunday at 00:00 UTC = 09:00 KST (UTC+9) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>0</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/jsa/work/epic_invest</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/jsa/work/epic_invest/.venv/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/jsa/work/epic_invest/logs/weekly_validation.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/jsa/work/epic_invest/logs/weekly_validation.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
